# ---- network ----
XMTP_ENV=dev                    # dev | production
PORT=3000

# ---- senders: 4 independent wallets (4 inboxes), hex private keys, no 0x prefix ----
SENDER_KEY_1=
SENDER_KEY_2=
SENDER_KEY_3=
SENDER_KEY_4=

# ---- security ----
API_TOKEN=                      # bearer token for POST /send-dm (required)
DB_ENCRYPTION_KEY=              # 64 hex chars (32 bytes), encrypts the local DB (required)

# ---- storage ----
STORAGE_MODE=memory              # memory (default, recommended) | file
DATA_DIR=./data                  # only used when STORAGE_MODE=file

# ---- performance ----
CLIENT_CONCURRENCY=8             # max in-flight sends per client
SEND_TIMEOUT_MS=30000
SEND_MAX_RETRIES=2
API_RATE_LIMIT_QPS=20            # token bucket on POST /send-dm
MAX_TEXT_LEN=4096

# ---- disappearing messages (阅后即焚) ----
# 0 = disabled. e.g. 24 = messages auto-expire 24h after being sent.
# App-level enforcement: compliant recipient apps delete from local storage;
# messages are NOT deleted from the XMTP network.
DISAPPEAR_IN_HOURS=0

# ---- self-healing ----
CIRCUIT_BREAKER_THRESHOLD=5      # consecutive failures before a client is fenced
REBUILD_BASE_DELAY_MS=2000       # exponential backoff base for client rebuild
ROTATION_INTERVAL_MS=21600000    # rolling client rebuild every 6h (0 = disabled)
HEALTH_PROBE_INTERVAL_MS=60000

# ---- optional ----
WARMUP_ADDRESSES=               # comma-separated 0x addresses to pre-create DMs for
LOG_LEVEL=info                  # debug | info | warn | error
XMTP_LOG_LEVEL=warn             # libxmtp native log level: off|error|warn|info|debug|trace
