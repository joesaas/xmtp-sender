# @xmtp packages must come from the official registry: some mirrors
# (e.g. npmmirror) lag behind on @xmtp/node-bindings — as of 2026-10 the
# mirror's latest was 1.6.9 while @xmtp/node-sdk@6.1.0 requires 1.11.0,
# which makes installs fail with ERR_PNPM_NO_MATCHING_VERSION.
# All other packages still use your configured default registry.
@xmtp:registry=https://registry.npmjs.org/
